{
  "name": "mascii-vscode",
  "displayName": "mascii math",
  "description": "Edit AA-format math formulas structurally (LyX-like) inside text files",
  "version": "0.1.0",
  "publisher": "mascii",
  "engines": { "vscode": "^1.85.0" },
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      { "command": "mascii.editFormula", "title": "mascii: Edit formula at cursor" },
      { "command": "mascii.toLatex", "title": "mascii: Convert AA selection to LaTeX" }
    ],
    "keybindings": [
      {
        "command": "mascii.editFormula",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "build-wasm": "cd ../../wasm && wasm-pack build --target web --out-dir ../editors/vscode/media/pkg"
  }
}
